	function GUI:SetTheme(theme)
		if Themes[theme] then
			Library:WriteConfig(options.Flag, theme)
	
			Library.CurrentTheme = Themes[theme]
	
			for k, v in pairs(ThemesItems) do
				if k:find("Slider") then
					v["BackgroundColor3"] = Library.CurrentTheme.SliderColor3
					v["BackgroundTransparency"] = (theme == "Xyros" or theme == "Classic") and 0
				elseif k:find("SImage") then
					v["Image"] = Library.CurrentTheme.SliderImage
					v["ImageTransparency"] = (theme == "Xyros" or theme == "Classic") and 0.5 or 0
				elseif k == "MainBackground" then
					v["Image"] = Library.CurrentTheme.MainFrameImage
					v["BackgroundTransparency"] = (theme == "Xyros" or theme == "Classic") and 1 or 0
				elseif k == "Logo" then
					v["Image"] = Library.CurrentTheme.DraggableLogoImage
					v["ImageTransparency"] = (theme == "Xyros" or theme == "Classic") and 0
				elseif k == "TopBarGradient" then
					v["Color"] = Library.CurrentTheme.UIGradientColor
				elseif k:find("FirstKey") or k:find("Keybind") or k:find("Textbox") then
					v["BackgroundColor3"] = Library.CurrentTheme.MainItemsColor3
					v["BackgroundTransparency"] = (theme == "Xyros" or theme == "Classic") and 0
				end
			end
		else
			Library.CurrentTheme = Themes["Xyros"]
		end
	end

	if options.Flag ~= false then
		if Library.CurrentTheme == nil and not Library:ReadConfig(options.Flag) then
			GUI:SetTheme("Xyros")
		else
			GUI:SetTheme(Library:ReadConfig(options.Flag))
		end
	else
		if not Library.CurrentTheme then
			GUI:SetTheme("Xyros")
		end
	end

	function GUI:AddDrag(Handle, MoveObj)
		MoveObj = MoveObj or GUI["2"]

		local dragToggle = false
		local dragStart
		local startPos

		local function updateInput(input)
			if GUI.Stop_Dragging then return end
			local delta = input.Position - dragStart

			MoveObj.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + delta.X,
				startPos.Y.Scale, startPos.Y.Offset + delta.Y
			)
		end

		Handle.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragToggle = true
				dragStart = input.Position
				startPos = MoveObj.Position

				input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then
						dragToggle = false
					end
				end)
			end
		end)

		uis.InputChanged:Connect(function(input)
			if (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) and dragToggle then
