				keycode = minimiser or Enum.KeyCode.Quote
			end

			if input.KeyCode == keycode then
				Cooldown = true
		
				if Library.Active then
					GUI["4"]["Visible"] = false
					GUI["b"]["Visible"] = false
					GUI["19"]["Visible"] = false
		
					Library:Tween(GUI["2"], {0.8, "Quart", "InOut"}, {Size = UDim2.new(0, 0, 0, 0)}, function()
