		GUI["Logo"].InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Touch then
				startPos = input.Position
				dragged = false
			end
		end)

		GUI["Logo"].InputChanged:Connect(function(input)
			if startPos and input.UserInputType == Enum.UserInputType.Touch then
				if (input.Position - startPos).Magnitude > TAP_DISTANCE then
					dragged = true
				end
			end
		end)

