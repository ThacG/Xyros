					GUI["2"]["Visible"] = true
					GUI["4"]["Visible"] = true
					GUI["b"]["Visible"] = true
					GUI["19"]["Visible"] = true
		
					Library.Active = true
		
					Library:Tween(GUI["2"], {0.8, "Quart", "InOut"}, {Size = UDim2.new(0, 500, 0, 300)}, function()
						Cooldown = false
					end)
