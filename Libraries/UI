		end)
	elseif uis.MouseEnabled and not uis.TouchEnabled then
		uis.InputBegan:Connect(function(input, gameProcessedEvent)
			if gameProcessedEvent or Cooldown then return end
		
			local saved = Library:ReadConfig("minimise-control")
			local keycode = saved

