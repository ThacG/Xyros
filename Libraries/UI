			function Dropdown:Refresh(new, delete)
				if type(new) ~= "table" then new = {"One", "Two", "Three"} end
				if #new < 1 then new = {"One", "Two", "Three"} end
			
				if delete then
					options.Options = new
				else
					local mergedOptions = {}
					local existingOptions = options.Options or {}
			
					for _, existingOption in ipairs(existingOptions) do
						if not table.find(new, existingOption) then
							table.insert(mergedOptions, existingOption)
						end
					end
					for _, newOption in ipairs(new) do
						table.insert(mergedOptions, newOption)
					end
			
					options.Options = mergedOptions
				end
			
				if options.Sort == false then
				else
					local function customSort(a, b)
						local function splitOption(option)
							local prefix, number = option:match("^(.-)%s*(%d*)$")
							return prefix or option, tonumber(number) or math.huge
						end
			
						local aPrefix, aNumber = splitOption(a)
						local bPrefix, bNumber = splitOption(b)
			
						local aIsSymbol = not a:sub(1, 1):match("[%w]")
						local bIsSymbol = not b:sub(1, 1):match("[%w]")
			
						if aIsSymbol and not bIsSymbol then
							return true
						elseif bIsSymbol and not aIsSymbol then
							return false
						end
			
						local aIsNumber = tonumber(a)
						local bIsNumber = tonumber(b)
			
						if aIsNumber and bIsNumber then
							return aIsNumber < bIsNumber
						elseif aIsNumber then
							return true
						elseif bIsNumber then
							return false
						end
			
						if aPrefix ~= bPrefix then
							return aPrefix < bPrefix
						end
			
						return aNumber < bNumber
					end
			
					table.sort(options.Options, customSort)
				end
			
				if options.Multi then
					local filteredSelected = {}
					for _, selectedOption in ipairs(Dropdown.Selected or {}) do
