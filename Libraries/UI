			function Slider:SetCallback(func)
				options.Callback = func
			end

			function Slider:Set(value)
				if value >= options.Min and value <= options.Max then
					local clampedValue = math.clamp(value, options.Min, options.Max)
					local adjustedValue = math.floor((clampedValue / options.Increment) + 0.5) * options.Increment
					local sliderPosition = (adjustedValue - options.Min) / (options.Max - options.Min)

					local sameValue = (tonumber(Slider["31"]["Text"]) == adjustedValue)

					Slider["31"]["Text"] = tostring(adjustedValue)
					Library:Tween(Slider["35"], {options.Speed, "Linear", "InOut"}, {
						Size = UDim2.fromScale(sliderPosition, Slider["35"]["Size"].Y.Scale)
					})

					if options.Flag ~= false then
						Library:WriteConfig(options.Flag, adjustedValue)
					end

					if not sameValue then
						options.Callback(options, adjustedValue)
					end

					return adjustedValue
				else
					if value < options.Min then
						return Slider:Set(options.Min)
					else
						return Slider:Set(options.Max)
					end
				end
			end

			Slider["2c"].MouseEnter:Connect(function()
				Library:Tween(Slider["2c"],{.3,"Linear","InOut"},{BackgroundColor3 = Color3.fromRGB(50, 50, 50)})

				GUI.Stop_Dragging = true
			end)

			Slider["2c"].MouseLeave:Connect(function()
				Library:Tween(Slider["2c"],{.3,"Linear","InOut"},{BackgroundColor3 = Color3.fromRGB(30, 30, 30)})

				GUI.Stop_Dragging = false

				if not Slider.Completed then Slider.Completed = true end
			end)

			Slider["2c"].MouseButton1Down:Connect(function()
				Library:Tween(Slider["2c"], {0.3, "Linear", "InOut"}, {BackgroundColor3 = Color3.fromRGB(80, 80, 80)})
				Slider.Completed = false
				local lastValue = tonumber(Slider["31"]["Text"])
				local connection
				connection = runService.RenderStepped:Connect(function()
					if not Slider.Completed then
						local mouseX = game.Players.LocalPlayer:GetMouse().X
						local sliderPosition = math.clamp((mouseX - Slider["32"].AbsolutePosition.X) / Slider["32"].AbsoluteSize.X, 0, 1)
						local newValue = options.Min + (sliderPosition * (options.Max - options.Min))
						newValue = math.floor((newValue / options.Increment) + 0.5) * options.Increment
						if newValue ~= lastValue then
							lastValue = newValue
							Slider:Set(newValue)
						end
					else
						connection:Disconnect()
					end
				end)
			end)
			
			Slider["2c"].MouseButton1Up:Connect(function()
				Library:Tween(Slider["2c"], {0.3, "Linear", "InOut"}, {BackgroundColor3 = Color3.fromRGB(60, 60, 60)})
				Slider.Completed = true
			end)

			if options.Flag ~= false then
				local value = Library:ReadConfig(options.Flag)

				if not value then
					if options.Default then
						Slider:Set(options.Default)
					else
						Slider:Set(options.Min-options.Max)
					end
				else
					Slider:Set(value)
				end
			else
				if options.Default then
					Slider:Set(options.Default)
				else
					Slider:Set(options.Min-options.Max)
				end
			end

			return Slider
		end

